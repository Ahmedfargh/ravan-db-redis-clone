<mxfile host="app.diagrams.net" modified="2026-08-15T22:38:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="lexer-fsm-diagram" name="Lexer Finite State Machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="title" value="Raven DB - Lexer Finite State Machine (Token Scanner)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Initial Start -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge_start" value="NewLexer(input)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#475569;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontStyle=1;fontSize=10;" edge="1" parent="1" source="start" target="state_read">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: ReadNextChar -->
        <mxCell id="state_read" value="ReadNextChar&#xa;(Examine byte ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- State: SkipWhitespace -->
        <mxCell id="state_ws" value="SkipWhitespace&#xa;(ch in ' ', \t, \n, \r)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="160" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_ws_in" value="Whitespace" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#475569;fontStyle=1;fontSize=10;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_read" target="state_ws">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ws_out" value="readChar()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#475569;fontStyle=1;fontSize=10;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_ws" target="state_read">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: Ident -->
        <mxCell id="state_ident" value="StateIdent&#xa;(Letter, '_', ':', '*', '-')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_ident" value="isLetter(ch)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_ident">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: Number -->
        <mxCell id="state_num" value="StateNumber&#xa;(Digit '0'-'9')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_num" value="isDigit(ch)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_num">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: String -->
        <mxCell id="state_str" value="StateString&#xa;(Quote '&quot;' or '\'')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="480" y="240" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_str" value="ch == quote" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_str">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: Parentheses -->
        <mxCell id="state_paren" value="StateParen&#xa;(ch in '(', ')')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_paren" value="ch == '(' or ')'" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_paren">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: EOF -->
        <mxCell id="state_eof" value="StateEOF&#xa;(ch == 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_eof" value="End of Input" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_eof">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- State: Illegal -->
        <mxCell id="state_err" value="StateIllegal&#xa;(Unexpected byte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_err" value="Invalid Byte" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B91C1C;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_err">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- EMIT TOKENS / TERMINATION -->
        <mxCell id="emit_node" value="Emit Token&#xa;to Stream" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="290" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;" edge="1" parent="1" source="state_ident" target="emit_node" />
        <mxCell id="e2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;" edge="1" parent="1" source="state_num" target="emit_node" />
        <mxCell id="e3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;" edge="1" parent="1" source="state_str" target="emit_node" />
        <mxCell id="e4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;" edge="1" parent="1" source="state_paren" target="emit_node" />
        <mxCell id="e5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="1" source="state_eof" target="emit_node" />
        <mxCell id="e6" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="1" source="state_err" target="emit_node" />

      </root>
    </mxGraphModel>
  </diagram>
