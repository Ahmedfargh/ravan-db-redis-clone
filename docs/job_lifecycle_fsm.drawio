          <mxGeometry x="60" y="125" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- State 1: Socket Received -->
        <mxCell id="state_1" value="StateSocketRead&#xa;(Raw TCP String Ingestion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_start" value="Ingest TCP bytes" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0284C7;fontStyle=1;fontSize=10;" edge="1" parent="1" source="start" target="state_1" />

        <!-- State 2: Job Queued -->
        <mxCell id="state_2" value="StateJobQueued&#xa;(Job pushed to JobQueue chan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
