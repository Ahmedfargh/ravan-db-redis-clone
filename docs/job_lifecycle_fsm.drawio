        </mxCell>
        <mxCell id="e_5_6" value="Command.Execute()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_5" target="state_6" />

        <!-- State 7: Response Dispatched -->
        <mxCell id="state_7" value="StateResponseDispatched&#xa;(Send result over chan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
