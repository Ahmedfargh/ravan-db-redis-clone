        <mxCell id="e_1_2" value="Create Job{Query, ResponseChan}" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_1" target="state_2" />

        <!-- State 3: Worker Dequeued -->
        <mxCell id="state_3" value="StateWorkerPicked&#xa;(Goroutine pops job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="780" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_2_3" value="Worker loop pops job" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_2" target="state_3" />

        <!-- State 4: Lexing & Parsing -->
        <mxCell id="state_4" value="StateLexingParsing&#xa;(Lexer &amp; Parser AST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_3_4" value="NewParserFromInput()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_3" target="state_4" />

        <!-- State 5: Evaluating -->
        <mxCell id="state_5" value="StateEvaluating&#xa;(Evaluator.EvaluateQuery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="1100" y="310" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_4_5" value="Pass AST to Evaluator" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_4" target="state_5" />

        <!-- State 6: DataStore Mutating -->
        <mxCell id="state_6" value="StateDataStoreMutating&#xa;(Read/Write under RLock/Lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#134E4A;" vertex="1" parent="1">
