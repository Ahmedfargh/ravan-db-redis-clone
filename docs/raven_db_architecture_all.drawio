<mxfile host="app.diagrams.net" modified="2026-08-15T22:38:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="master-overview" name="Master System Overview">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Master Title Header -->
        <mxCell id="title" value="Raven DB - Master Architecture &amp; Subsystem Specification Overview" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- Container 1: Client TCP Ingestion -->
        <mxCell id="box_client" value="1. Client &amp; Network Ingestion&#xa;--&#xa;• TcpServer (port 6379)&#xa;• Read bytes from net.Conn&#xa;• Non-blocking connection dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;align=left;spacingLeft=15;fontStyle=1;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- Container 2: Concurrency Worker Pool -->
        <mxCell id="box_worker" value="2. Worker Pool Concurrency Engine&#xa;--&#xa;• Buffered JobQueue channel&#xa;• N Goroutine Workers&#xa;• Dequeues Query Job{Query, ResponseChan}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;align=left;spacingLeft=15;fontStyle=1;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="flow_1_2" value="Push Job" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0369A1;fontStyle=1;fontSize=11;" edge="1" parent="1" source="box_client" target="box_worker" />

        <!-- Container 3: Lexer & Parser FSM -->
        <mxCell id="box_parser" value="3. Lexer Scanner &amp; AST Parser FSM&#xa;--&#xa;• Lexer: Character stream -&gt; []Token&#xa;• Parser: Recursive Descent State Machine&#xa;• Emits Root *CommandExpr AST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;align=left;spacingLeft=15;fontStyle=1;fontSize=12;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="flow_2_3" value="Parse Raw Query" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=11;" edge="1" parent="1" source="box_worker" target="box_parser" />

        <!-- Container 4: AST Evaluator & Command Registry -->
        <mxCell id="box_eval" value="4. Evaluator &amp; Command Registry&#xa;--&#xa;• Evaluator.EvaluateQuery(ast)&#xa;• Dynamic Command Registry Lookup&#xa;• Execute(args) -&gt; (string, error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;align=left;spacingLeft=15;fontStyle=1;fontSize=12;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="flow_3_4" value="Pass AST Node" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=11;" edge="1" parent="1" source="box_parser" target="box_eval" />

        <!-- Container 5: Memory Storage Engine -->
        <mxCell id="box_storage" value="5. Thread-Safe Memory Storage Engine&#xa;--&#xa;• DataStore: map[string]*DataValue&#xa;• Guarded by sync.RWMutex&#xa;• TTL Expiration &amp; Type Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;align=left;spacingLeft=15;fontStyle=1;fontSize=12;fontColor=#134E4A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="340" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="flow_4_5" value="Execute Mutate/Read" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=11;" edge="1" parent="1" source="box_eval" target="box_storage" />

        <!-- Response Flow Return Path -->
        <mxCell id="flow_resp" value="Return Response bytes via job.ResponseChan to Client Socket" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="box_storage" target="box_client">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1350" y="540" />
              <mxPoint x="200" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Subsystem Tabs Navigation Banner -->
        <mxCell id="nav_banner" value="Draw.io Workbook Navigation Tabs:&#xa;[Tab 1: Master System Overview]  •  [Tab 2: System Architecture &amp; UML]  •  [Tab 3: Syntax Evaluation Lifecycle]  •  [Tab 4: Job Lifecycle FSM]  •  [Tab 5: Lexer FSM]  •  [Tab 6: AST Parser FSM]" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;align=center;fontStyle=1;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1440" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="system-architecture-uml" name="System Architecture UML Class Diagram">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="880" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="title" value="Raven DB - System Architecture UML Class &amp; Component Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="750" height="40" as="geometry" />
        </mxCell>

        <!-- CONTAINER LAYERS -->
        <mxCell id="layer_ingestion" value="Ingestion &amp; Concurrency Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#0369A1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="540" height="210" as="geometry" />
        </mxCell>

        <mxCell id="layer_parsing" value="Parsing &amp; AST Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#3730A3;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="550" height="210" as="geometry" />
        </mxCell>

        <mxCell id="layer_execution" value="Execution Engine &amp; Command Registry Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#14532D;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1130" height="480" as="geometry" />
        </mxCell>

        <mxCell id="layer_storage" value="Storage Engine Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0D9488;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#134E4A;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="1210" y="340" width="500" height="480" as="geometry" />
        </mxCell>

        <!-- CLASSES INSIDE LAYERS -->
        <mxCell id="c_tcpserver" value="TcpServer&#xa;--&#xa;- listener: net.Listener&#xa;- workerPool: *WorkerPool&#xa;- port: int&#xa;--&#xa;+ NewTcpServer(wp, port): *TcpServer&#xa;+ HandleConnections()" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#0369A1;" vertex="1" parent="layer_ingestion">
          <mxGeometry x="30" y="50" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_workerpool" value="WorkerPool&#xa;--&#xa;+ JobQueue: chan Job&#xa;+ WorkerCount: int&#xa;- evaluator: *Evaluator&#xa;--&#xa;+ NewWorkerPool(count, queueSize): *WorkerPool&#xa;+ Start()&#xa;- executeJob(job, id): Response" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="layer_ingestion">
          <mxGeometry x="280" y="50" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rel_1" value="uses" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="layer_ingestion" source="c_tcpserver" target="c_workerpool" />

        <mxCell id="c_lexer" value="Lexer&#xa;--&#xa;- input: string&#xa;- position: int&#xa;- readPosition: int&#xa;- ch: byte&#xa;--&#xa;+ NewLexer(input): *Lexer&#xa;+ NextToken(): Token&#xa;+ Tokenize(): ([]Token, error)" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="layer_parsing">
          <mxGeometry x="30" y="50" width="220" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c_parser" value="Parser&#xa;--&#xa;- tokens: []Token&#xa;- pos: int&#xa;--&#xa;+ NewParser(tokens): *Parser&#xa;+ NewParserFromInput(input): (*Parser, error)&#xa;+ Parse(): (*CommandExpr, error)&#xa;+ ParseCommand(): (*CommandExpr, error)" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="layer_parsing">
          <mxGeometry x="280" y="50" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rel_2" value="uses" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="layer_parsing" source="c_parser" target="c_lexer" />

        <mxCell id="c_eval" value="Evaluator&#xa;--&#xa;- registry: *CommandRegistry&#xa;--&#xa;+ NewEvaluator(registry): *Evaluator&#xa;+ EvaluateQuery(query): (string, error)&#xa;+ Evaluate(node): (string, error)" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="layer_execution">
          <mxGeometry x="30" y="60" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_reg" value="CommandRegistry&#xa;--&#xa;- mu: sync.RWMutex&#xa;- commands: map[string]Command&#xa;--&#xa;+ Register(name, handler: any)&#xa;+ Get(name): (Command, bool)&#xa;+ Execute(name, args): (string, error)" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#14532D;" vertex="1" parent="layer_execution">
          <mxGeometry x="330" y="60" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rel_5" value="dispatches commands" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="layer_execution" source="c_eval" target="c_reg" />

        <mxCell id="c_iface" value="&lt;&lt;Interface&gt;&gt;&#xa;Command&#xa;--&#xa;+ Execute(args: []string): (string, error)" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;align=center;fontStyle=1;fontSize=11;fontColor=#713F12;" vertex="1" parent="layer_execution">
          <mxGeometry x="630" y="60" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rel_6" value="holds map[string]" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#CA8A04;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#854D0E;fontStyle=1;fontSize=10;" edge="1" parent="layer_execution" source="c_reg" target="c_iface" />

        <mxCell id="c_cmds" value="Concrete Command Implementations&#xa;--&#xa;• PingCommand    • SetCommand&#xa;• GetCommand     • DelCommand&#xa;• ExistsCommand  • KeysCommand&#xa;• ExpireCommand  • TtlCommand&#xa;• IncrCommand    • DecrCommand&#xa;• MgetCommand    • MsetCommand&#xa;• EchoCommand" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#581C87;" vertex="1" parent="layer_execution">
          <mxGeometry x="630" y="210" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="rel_7" value="implements" style="endArrow=block;endFill=0;dashed=1;html=1;strokeWidth=2;strokeColor=#9333EA;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#7E22CE;fontStyle=1;fontSize=10;" edge="1" parent="layer_execution" source="c_cmds" target="c_iface" />

        <mxCell id="c_ds" value="DataStore&#xa;--&#xa;- mu: sync.RWMutex&#xa;+ Data: map[string]*DataValue&#xa;--&#xa;+ GetValue(key): (*DataValue, bool)&#xa;+ SetValue(key, val, ttl): (*DataValue, bool)&#xa;+ DelValue(key): bool" style="swipeable=0;html=1;shape=mxgraph.bootstrap.rrect;rSize=5;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fontColor=#134E4A;" vertex="1" parent="layer_storage">
