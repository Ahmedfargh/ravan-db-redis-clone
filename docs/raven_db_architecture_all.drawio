        <!-- FLOW STEPS -->
        <mxCell id="flow_1" value="1. Send Query: 'SET user_role (GET default_role)'" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0369A1;fontStyle=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="100" y="180" as="sourcePoint" />
            <mxPoint x="345" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="flow_2" value="2. Lexer.Tokenize()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="345" y="240" as="sourcePoint" />
            <mxPoint x="575" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="box_lexer_tokens" value="Token Stream: [IDENT(&quot;SET&quot;), IDENT(&quot;user_role&quot;),&#xa;LPAREN(&quot;(&quot;), IDENT(&quot;GET&quot;), IDENT(&quot;default_role&quot;), RPAREN(&quot;)&quot;)]" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#78350F;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="530" y="270" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="flow_2_ret" value="Return []Token" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="575" y="345" as="sourcePoint" />
            <mxPoint x="345" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="flow_3" value="3. Parser.Parse()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="345" y="385" as="sourcePoint" />
            <mxPoint x="800" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="box_ast" value="AST Tree Structure:&#xa;CommandExpr(&quot;SET&quot;)&#xa; ├── Arg[0]: StringLiteral(&quot;user_role&quot;)&#xa; └── Arg[1]: CommandExpr(&quot;GET&quot;) -&gt; Arg[0]: StringLiteral(&quot;default_role&quot;)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#312E81;fillColor=#E0E7FF;strokeColor=#6366F1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="415" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="flow_3_ret" value="Return Root *CommandExpr" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="495" as="sourcePoint" />
            <mxPoint x="345" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="flow_4" value="4. Evaluator.Evaluate(RootASTNode)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="345" y="535" as="sourcePoint" />
            <mxPoint x="1035" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="subcmd_bg" value="" style="rounded=1;fillColor=#FFF1F2;strokeColor=#FDA4AF;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="565" width="510" height="130" as="geometry" />
        </mxCell>
        <mxCell id="subcmd_title" value="Nested Expression Evaluation: (GET default_role)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=11;fontColor=#9F1239;" vertex="1" parent="1">
          <mxGeometry x="1020" y="570" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flow_get_reg" value="Lookup &quot;GET&quot;" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1035" y="600" as="sourcePoint" />
            <mxPoint x="1270" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_get_ds" value="GetValue(&quot;default_role&quot;) [RLock]" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1270" y="630" as="sourcePoint" />
            <mxPoint x="1465" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_get_ds_ret" value="Return &quot;Administrator&quot;" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1465" y="665" as="sourcePoint" />
            <mxPoint x="1035" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="step6_label" value="6. Outer SET Execution: Resolved Args [&quot;user_role&quot;, &quot;Administrator&quot;]" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#DCFCE7;fontStyle=1;fontSize=11;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="920" y="700" width="370" height="25" as="geometry" />
        </mxCell>
        <mxCell id="flow_set_reg" value="Execute(&quot;SET&quot;, [&quot;user_role&quot;, &quot;Administrator&quot;])" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1035" y="730" as="sourcePoint" />
            <mxPoint x="1270" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_set_ds" value="SetValue(&quot;user_role&quot;, &quot;Administrator&quot;) [Lock]" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1270" y="760" as="sourcePoint" />
            <mxPoint x="1465" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_set_ds_ret" value="Success -&gt; Return &quot;OK\n&quot;" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1465" y="795" as="sourcePoint" />
            <mxPoint x="345" y="795" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="flow_final_ret" value="7. Response Bytes: &quot;OK\n&quot;" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0369A1;fontStyle=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="345" y="835" as="sourcePoint" />
            <mxPoint x="100" y="835" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="job-lifecycle-fsm" name="Query Job Lifecycle State Machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="500" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Raven DB - Query Job Lifecycle State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="state_1" value="StateSocketRead&#xa;(Raw TCP String Ingestion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_start" value="Ingest TCP bytes" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0284C7;fontStyle=1;fontSize=10;" edge="1" parent="1" source="start" target="state_1" />

        <mxCell id="state_2" value="StateJobQueued&#xa;(Job pushed to JobQueue chan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_1_2" value="Create Job{Query, ResponseChan}" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_1" target="state_2" />

        <mxCell id="state_3" value="StateWorkerPicked&#xa;(Goroutine pops job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="780" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_2_3" value="Worker loop pops job" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_2" target="state_3" />

        <mxCell id="state_4" value="StateLexingParsing&#xa;(Lexer &amp; Parser AST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_3_4" value="NewParserFromInput()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_3" target="state_4" />

        <mxCell id="state_5" value="StateEvaluating&#xa;(Evaluator.EvaluateQuery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="1100" y="310" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_4_5" value="Pass AST to Evaluator" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_4" target="state_5" />

        <mxCell id="state_6" value="StateDataStoreMutating&#xa;(Read/Write under RLock/Lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#134E4A;" vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_5_6" value="Command.Execute()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_5" target="state_6" />

        <mxCell id="state_7" value="StateResponseDispatched&#xa;(Send result over chan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="460" y="310" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_6_7" value="job.ResponseChan &lt;- res" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_6" target="state_7" />

        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="200" y="325" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e_7_end" value="Write to TCP socket" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_7" target="end" />

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="lexer-fsm-diagram" name="Lexer Finite State Machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Raven DB - Lexer Finite State Machine (Token Scanner)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge_start" value="NewLexer(input)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#475569;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontStyle=1;fontSize=10;" edge="1" parent="1" source="start" target="state_read">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_read" value="ReadNextChar&#xa;(Examine byte ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="state_ws" value="SkipWhitespace&#xa;(ch in ' ', \t, \n, \r)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="160" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_ws_in" value="Whitespace" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#475569;fontStyle=1;fontSize=10;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_read" target="state_ws">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ws_out" value="readChar()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#475569;fontStyle=1;fontSize=10;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_ws" target="state_read">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_ident" value="StateIdent&#xa;(Letter, '_', ':', '*', '-')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_ident" value="isLetter(ch)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_ident">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_num" value="StateNumber&#xa;(Digit '0'-'9')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_num" value="isDigit(ch)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_num">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_str" value="StateString&#xa;(Quote '&quot;' or '\'')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="480" y="240" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_str" value="ch == quote" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_str">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_paren" value="StateParen&#xa;(ch in '(', ')')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_paren" value="ch == '(' or ')'" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_paren">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_eof" value="StateEOF&#xa;(ch == 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_eof" value="End of Input" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_eof">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_err" value="StateIllegal&#xa;(Unexpected byte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge_err" value="Invalid Byte" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B91C1C;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_read" target="state_err">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="emit_node" value="Emit Token&#xa;to Stream" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="290" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;" edge="1" parent="1" source="state_ident" target="emit_node" />
        <mxCell id="e2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;" edge="1" parent="1" source="state_num" target="emit_node" />
        <mxCell id="e3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;" edge="1" parent="1" source="state_str" target="emit_node" />
        <mxCell id="e4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;" edge="1" parent="1" source="state_paren" target="emit_node" />
        <mxCell id="e5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;" edge="1" parent="1" source="state_eof" target="emit_node" />
        <mxCell id="e6" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;" edge="1" parent="1" source="state_err" target="emit_node" />

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="parser-fsm-diagram" name="AST Parser Finite State Machine">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="550" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Raven DB - AST Parser Finite State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="state_check_paren" value="StateCheckParen&#xa;(Check if LPAREN '(')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="180" y="220" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_start" value="Parser.ParseCommand()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#475569;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#334155;fontStyle=1;fontSize=10;" edge="1" parent="1" source="start" target="state_check_paren">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_cmd" value="StateExpectCommand&#xa;(Token must be IDENT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_cmd" value="isEnclosedInParen / curToken" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2563EB;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#1D4ED8;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_check_paren" target="state_cmd">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_err" value="StateSyntaxError&#xa;(Return Parse Error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="460" y="400" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_err" value="Unexpected Token" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B91C1C;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_cmd" target="state_err">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_expr" value="StateParseExpression&#xa;(Loop over tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="780" y="220" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_expr" value="Create CommandExpr node" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#B45309;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_cmd" target="state_expr">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_lit" value="StringLiteral /&#xa;NumberLiteral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_lit" value="TOKEN_STRING / NUMBER" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_expr" target="state_lit">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_lit_back" value="Append to Args" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#15803D;fontStyle=1;fontSize=10;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_lit" target="state_expr">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_nested" value="StateNestedExpr&#xa;TOKEN_LPAREN '('" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="780" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_nested" value="Recursive ParseCommand()" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_expr" target="state_nested">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_nested_back" value="Append Sub-CommandExpr to Args" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="state_nested" target="state_expr">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="state_done" value="StateCompleteCommand&#xa;(Return *CommandExpr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="1120" y="220" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge_done" value="TOKEN_EOF or RPAREN ')'" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;" edge="1" parent="1" source="state_expr" target="state_done">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1400" y="235" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge_final" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="1" source="state_done" target="end" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
