        <mxCell id="rel_9" value="contains" style="endArrow=open;dashed=1;html=1;strokeWidth=2;strokeColor=#475569;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#334155;fontStyle=1;fontSize=10;" edge="1" parent="layer_storage" source="c_ds" target="c_dv" />

        <!-- CROSS-LAYER CONNECTORS -->
        <mxCell id="rel_3" value="invokes" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#DB2777;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#BE185D;fontStyle=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c_workerpool" target="c_eval" />
        <mxCell id="rel_4" value="parses via" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4F46E5;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#4338CA;fontStyle=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c_eval" target="c_parser" />
        <mxCell id="rel_8" value="mutates / reads" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#0D9488;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontColor=#0F766E;fontStyle=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c_cmds" target="c_ds" />

